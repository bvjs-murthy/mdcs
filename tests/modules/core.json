{
    "test_name": "MDCS Core + Server \u2014 black-box integration suite",
    "application": {
        "path": "./apps/core/target/classes",
        "command": [
            "java",
            "-cp",
            "{application}{sep}{root}/shared/target/classes{sep}{root}/apps/core/target/dependency/*",
            "com.mdcs.core.Main"
        ],
        "cwd": "{root}"
    },
    "timeout": 20,
    "prerequisites": [
        {
            "name": "build Core and copy runtime dependencies",
            "persistent": false,
            "command": [
                "mvn",
                "-q",
                "-pl",
                "apps/core",
                "-am",
                "compile"
            ],
            "cwd": "{root}"
        },
        {
            "name": "copy Core runtime dependencies",
            "persistent": false,
            "command": [
                "mvn",
                "-q",
                "-pl",
                "apps/core",
                "dependency:copy-dependencies",
                "-DincludeScope=runtime",
                "-DoutputDirectory=target/dependency"
            ],
            "cwd": "{root}"
        },
        {
            "name": "MDCS server",
            "persistent": true,
            "command": [
                "go",
                "run",
                "."
            ],
            "cwd": "{root}/server",
            "ready": {
                "type": "port",
                "host": "127.0.0.1",
                "port": 1800,
                "timeout": 15
            }
        }
    ],
    "cases": [
        {
            "name": "no_command",
            "args": [],
            "expected": {
                "exit_code": 2
            }
        },
        {
            "name": "unknown_command",
            "args": [
                "unknown"
            ],
            "expected": {
                "exit_code": 2
            },
            "notes": "Should be BAD_REQUEST; exposes default fall-through if still present."
        },
        {
            "name": "flow_extra_argument",
            "args": [
                "flow",
                "extra"
            ],
            "expected": {
                "exit_code": 2
            }
        },
        {
            "name": "bootstrap_extra_argument",
            "args": [
                "bootstrap",
                "extra"
            ],
            "expected": {
                "exit_code": 2
            }
        },
        {
            "name": "auth_missing_option",
            "args": [
                "auth"
            ],
            "expected": {
                "exit_code": 2
            }
        },
        {
            "name": "auth_extra_argument",
            "args": [
                "auth",
                "login",
                "extra"
            ],
            "expected": {
                "exit_code": 2
            }
        },
        {
            "name": "auth_unknown_option",
            "args": [
                "auth",
                "unknown"
            ],
            "expected": {
                "exit_code": 2
            }
        },
        {
            "name": "enroll_missing_option",
            "args": [
                "enroll"
            ],
            "expected": {
                "exit_code": 2
            }
        },
        {
            "name": "enroll_extra_argument",
            "args": [
                "enroll",
                "first",
                "extra"
            ],
            "expected": {
                "exit_code": 2
            }
        },
        {
            "name": "enroll_unknown_option",
            "args": [
                "enroll",
                "unknown"
            ],
            "expected": {
                "exit_code": 2
            }
        },
        {
            "name": "enroll_genkey",
            "args": [
                "enroll",
                "genkey"
            ],
            "status": "wip",
            "notes": "Client and server implementation are not complete yet."
        },
        {
            "name": "enroll_additional_server_handler",
            "args": [
                "enroll",
                "additional"
            ],
            "status": "wip",
            "notes": "Server addEnroll handler is currently unimplemented."
        },
        {
            "name": "bootstrap_clean_environment",
            "args": [
                "bootstrap"
            ],
            "expected": {
                "exit_code": 0,
                "assert": {
                    "files": [
                        {
                            "path": "{app_data}/entities/Accounts.json",
                            "exists": true
                        },
                        {
                            "path": "{app_data}/entities/Device.json",
                            "exists": true
                        },
                        {
                            "path": "{app_data}/application/Configs.json",
                            "exists": true
                        },
                        {
                            "path": "{app_data}/application/ModulePaths.json",
                            "exists": true
                        },
                        {
                            "path": "{app_data}/application/Data.json",
                            "exists": true
                        },
                        {
                            "path": "{app_data}/plugins/Plugin.json",
                            "exists": true
                        },
                        {
                            "path": "{app_data}/secrets/Cikey.key",
                            "exists": true
                        }
                    ],
                    "ipc": [
                        {
                            "service": "LOG",
                            "action": "INFO",
                            "payload_contains": "Initiating application bootstrap"
                        }
                    ]
                }
            }
        },
        {
            "name": "bootstrap_invalid_accounts_json",
            "args": [
                "bootstrap"
            ],
            "expected": {
                "exit_code": 0,
                "assert": {
                    "files": [
                        {
                            "path": "{app_data}/entities/Accounts.json",
                            "exists": true
                        }
                    ]
                }
            },
            "setup": [
                {
                    "command": [
                        "python3",
                        "-c",
                        "from pathlib import Path; p=Path(r'{app_data}/entities/Accounts.json'); p.parent.mkdir(parents=True,exist_ok=True); p.write_text('{ hello',encoding='utf-8')"
                    ]
                }
            ]
        },
        {
            "name": "bootstrap_invalid_version_format",
            "args": [
                "bootstrap"
            ],
            "expected": {
                "exit_code": 23
            },
            "notes": "Requires versions.properties fixture to be injected before launch; see runner README."
        },
        {
            "name": "flow_logged_out_select_login",
            "args": [
                "flow"
            ],
            "expected": {
                "exit_code": 24,
                "assert": {
                    "ipc": [
                        {
                            "service": "LOG",
                            "action": "INFO",
                            "payload_contains": "Resolved user state to LOGGED_OUT"
                        }
                    ]
                }
            },
            "setup": [
                {
                    "command": [
                        "python3",
                        "-c",
                        "import json; from pathlib import Path; p=Path(r'{app_data}/entities/Device.json'); p.parent.mkdir(parents=True,exist_ok=True); json.dump({'device_id':'00000000-0000-0000-0000-000000000001','device_name':'test-device','workspace_id':'00000000-0000-0000-0000-000000000002','workspace_name':'test-workspace'},p.open('w'),indent=2)"
                    ]
                }
            ],
            "input": {
                "responses": {
                    "AUTH_CHOICE": "login",
                    "LOGIN": {
                        "email": "does-not-exist@example.com",
                        "pswd": "WrongPass1!",
                        "extra": "ignored"
                    }
                }
            },
            "notes": "Current App maps AuthState.RETRY to exit 24. Revisit when final exit mapping is stabilized."
        },
        {
            "name": "auth_login_invalid_credentials",
            "args": [
                "auth",
                "login"
            ],
            "expected": {
                "exit_code": 24
            },
            "setup": [
                {
                    "command": [
                        "python3",
                        "-c",
                        "import json; from pathlib import Path; p=Path(r'{app_data}/entities/Device.json'); p.parent.mkdir(parents=True,exist_ok=True); json.dump({'device_id':'00000000-0000-0000-0000-000000000001','device_name':'test-device','workspace_id':'00000000-0000-0000-0000-000000000002','workspace_name':'test-workspace'},p.open('w'),indent=2)"
                    ]
                }
            ],
            "input": {
                "responses": {
                    "LOGIN": {
                        "email": "does-not-exist@example.com",
                        "pswd": "WrongPass1!"
                    }
                }
            }
        },
        {
            "name": "auth_register_short_password",
            "args": [
                "auth",
                "register"
            ],
            "expected": {
                "exit_code": 24
            },
            "input": {
                "responses": {
                    "REGISTER": {
                        "username": "test-user",
                        "email": "test@example.com",
                        "pswd": "weak"
                    }
                }
            }
        },
        {
            "name": "enroll_first_no_user",
            "args": [
                "enroll",
                "first"
            ],
            "expected": {
                "exit_code": 23
            },
            "input": {
                "responses": {
                    "FIR_ENROLL": {
                        "device_name": "test-device",
                        "workspace_name": "test-workspace"
                    }
                }
            }
        },
        {
            "name": "server_ping",
            "process": false,
            "server_checks": [
                {
                    "method": "GET",
                    "url": "http://127.0.0.1:1800/mdcs/ping",
                    "expect": {
                        "status": 200,
                        "contains": "Hello, there!"
                    }
                }
            ]
        },
        {
            "name": "server_signup_malformed_json",
            "process": false,
            "server_checks": [
                {
                    "method": "POST",
                    "url": "http://127.0.0.1:1800/mdcs/auth/user/signup",
                    "expect": {
                        "status": 200,
                        "json": {
                            "status": false,
                            "error": "INVALID_DATA"
                        }
                    },
                    "raw_body": "{ hello"
                }
            ]
        },
        {
            "name": "server_signup_short_password",
            "process": false,
            "server_checks": [
                {
                    "method": "POST",
                    "url": "http://127.0.0.1:1800/mdcs/auth/user/signup",
                    "expect": {
                        "status": 200,
                        "json": {
                            "status": false,
                            "error": "SHORT_PASSWORD"
                        }
                    },
                    "body": {
                        "username": "test",
                        "email": "test@example.com",
                        "password": "A1!"
                    }
                }
            ]
        },
        {
            "name": "server_signup_missing_uppercase",
            "process": false,
            "server_checks": [
                {
                    "method": "POST",
                    "url": "http://127.0.0.1:1800/mdcs/auth/user/signup",
                    "expect": {
                        "status": 200,
                        "json": {
                            "status": false,
                            "error": "MISSING_UPPERCASE"
                        }
                    },
                    "body": {
                        "username": "test",
                        "email": "test@example.com",
                        "password": "lower1!"
                    }
                }
            ]
        },
        {
            "name": "server_signup_missing_lowercase",
            "process": false,
            "server_checks": [
                {
                    "method": "POST",
                    "url": "http://127.0.0.1:1800/mdcs/auth/user/signup",
                    "expect": {
                        "status": 200,
                        "json": {
                            "status": false,
                            "error": "MISSING_LOWERCASE"
                        }
                    },
                    "body": {
                        "username": "test",
                        "email": "test@example.com",
                        "password": "UPPER1!"
                    }
                }
            ]
        },
        {
            "name": "server_signup_missing_digit",
            "process": false,
            "server_checks": [
                {
                    "method": "POST",
                    "url": "http://127.0.0.1:1800/mdcs/auth/user/signup",
