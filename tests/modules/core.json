                }
            ]
        },
        {
            "name": "server_version_malformed_json",
            "process": false,
            "server_checks": [
                {
                    "method": "POST",
                    "url": "http://127.0.0.1:1800/mdcs/version/check",
                    "expect": {
                        "status": 200,
                        "contains": ""
                    },
                    "raw_body": "{ hello"
                }
            ]
        },
        {
            "name": "server_version_empty_request",
            "process": false,
            "server_checks": [
                {
                    "method": "POST",
                    "url": "http://127.0.0.1:1800/mdcs/version/check",
                    "expect": {
                        "status": 200
                    },
                    "body": {}
                }
            ]
        },
        {
            "name": "register_duplicate_user",
            "status": "wip",
            "notes": "Requires a disposable PostgreSQL fixture containing the user."
        },
        {
            "name": "register_otp_expired",
            "status": "wip",
            "notes": "Requires deterministic OTP insertion/time fixture."
        },
        {
            "name": "register_incorrect_otp",
            "status": "wip",
            "notes": "Requires deterministic OTP fixture."
        },
        {
            "name": "register_otp_not_found",
            "status": "wip",
            "notes": "Requires a user with no OTP row."
        },
        {
            "name": "first_enroll_unverified_user",
            "status": "wip",
            "notes": "Requires DB fixture with phase=UNVERIFIED."
        },
        {
            "name": "first_enroll_onboarded_user",
            "status": "wip",
            "notes": "Requires DB fixture with phase=ONBOARDED."
        },
        {
            "name": "first_enroll_duplicate_workspace",
            "status": "wip",
            "notes": "Requires DB fixture with an existing workspace name."
        },
        {
            "name": "first_enroll_duplicate_device",
            "status": "wip",
            "notes": "Requires DB fixture with an existing device name."
        },
        {
            "name": "login_unverified_user",
            "status": "wip",
            "notes": "Requires DB + deterministic OTP fixture."
        },
        {
            "name": "login_verified_user",
            "status": "wip",
            "notes": "Requires DB fixture with phase=VERIFIED and manager enrollment response."
        },
        {
            "name": "login_onboarded_user",
            "status": "wip",
            "notes": "Requires DB fixture with phase=ONBOARDED."
        },
        {
            "name": "server_db_unavailable",
            "status": "wip",
            "notes": "Requires starting server with a deliberately invalid DB_CONNECTION_STR."
        },
        {
            "name": "server_metadata_unavailable",
            "status": "wip",
            "notes": "Requires starting server with a deliberately invalid VERSION_DATA_URL."
        },
        {
            "name": "bootstrap_optional_update",
            "status": "wip",
            "notes": "Requires controlled version metadata response."
        },
        {
            "name": "bootstrap_critical_update",
            "status": "wip",
            "notes": "Requires controlled version metadata response."
        },
        {
            "name": "bootstrap_plugin_update",
            "status": "wip",
            "notes": "Requires controlled version metadata response."
        },
        {
            "name": "bootstrap_plugin_incompatible",
            "status": "wip",
            "notes": "Requires controlled version metadata response."
        }
    ]
}