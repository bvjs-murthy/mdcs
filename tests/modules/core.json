                        "email": "not-an-email",
                        "password": "Upper1!"
                    }
                }
            ]
        },
        {
            "name": "server_verify_missing_data",
            "process": false,
            "server_checks": [
                {
                    "method": "POST",
                    "url": "http://127.0.0.1:1800/mdcs/auth/user/verify-otp",
                    "expect": {
                        "status": 200,
                        "json": {
                            "status": false,
                            "error": "INVALID_DATA"
                        }
                    },
                    "body": {
                        "user_id": "",
                        "email": "",
                        "otp": ""
                    }
                }
            ]
        },
        {
            "name": "server_verify_malformed_json",
            "process": false,
            "server_checks": [
                {
                    "method": "POST",
                    "url": "http://127.0.0.1:1800/mdcs/auth/user/verify-otp",
                    "expect": {
                        "status": 200,
                        "json": {
                            "status": false,
                            "error": "INVALID_DATA"
                        }
                    },
                    "raw_body": "{ hello"
                }
            ]
        },
        {
            "name": "server_first_enroll_missing_data",
            "process": false,
            "server_checks": [
                {
                    "method": "POST",
                    "url": "http://127.0.0.1:1800/mdcs/auth/user/first-enroll",
                    "expect": {
                        "status": 200,
                        "json": {
                            "status": false,
                            "error": "INVALID_DATA"
                        }
                    },
                    "body": {
                        "user_id": "",
                        "device_name": "",
                        "workspace_name": ""
                    }
                }
            ]
        },
        {
            "name": "server_additional_enroll_missing_pairing_key",
            "process": false,
            "server_checks": [
                {
                    "method": "POST",
                    "url": "http://127.0.0.1:1800/mdcs/auth/user/additional-enroll",
                    "expect": {
                        "status": 200,
                        "json": {
                            "status": false,
                            "error": "INVALID_DATA"
                        }
                    },
                    "body": {
                        "user_id": "x",
                        "device_name": "d",
                        "workspace_name": "w",
                        "pairing_key": ""
