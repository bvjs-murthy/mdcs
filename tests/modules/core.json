                            "status": false,
                            "error": "MISSING_DIGIT"
                        }
                    },
                    "body": {
                        "username": "test",
                        "email": "test@example.com",
                        "password": "Upperlower!"
                    }
                }
            ]
        },
        {
            "name": "server_signup_missing_special",
            "process": false,
            "server_checks": [
                {
                    "method": "POST",
                    "url": "http://127.0.0.1:1800/mdcs/auth/user/signup",
                    "expect": {
                        "status": 200,
                        "json": {
                            "status": false,
                            "error": "MISSING_SPECIAL"
                        }
                    },
                    "body": {
                        "username": "test",
                        "email": "test@example.com",
                        "password": "Upperlower1"
                    }
                }
            ]
        },
        {
            "name": "server_signup_invalid_email",
            "process": false,
            "server_checks": [
                {
                    "method": "POST",
                    "url": "http://127.0.0.1:1800/mdcs/auth/user/signup",
                    "expect": {
                        "status": 200,
